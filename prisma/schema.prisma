generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  username          String    @unique
  email             String    @unique
  name              String
  password          String
  profile_image_url String?
  bio               String?
  premium           Boolean   @default(false)
  plan_expires_at   DateTime?
  role              Role      @default(USER)
  created_at        DateTime  @default(now())

  userGames UserGame[]
  reviews   Review[]
  likes     ReviewLike[]
}

enum Role {
  USER
  ADMIN
}

// -------------------------------------------------

model UserGame {
  id        String     @id @default(cuid())
  userId    String
  gameId    Int
  game_name String?
  status    GameStatus
  note      String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId, status])
  @@index([userId])
  @@index([gameId])
}

enum GameStatus {
  BACKLOG
  PLAYING
  FINISHED
  DROPPED
}

// ------------------------------------------------------------------------------------

model Review {
  id           String       @id @default(cuid())
  userId       String
  gameId       Int
  title        String
  body         String?
  rating       Int?
  isPublic     Boolean      @default(true)
  status       ReviewStatus @default(PUBLISHED)
  published_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  author User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes  ReviewLike[]

  @@unique([userId, gameId], name: "userId_rawgId")
  @@index([isPublic, status, published_at])
  @@index([gameId, isPublic, status, published_at])
  @@index([userId, status, updated_at])
}

enum ReviewStatus {
  DRAFT
  PUBLISHED
}

model ReviewLike {
  id         String   @id @default(cuid())
  reviewId   String
  userId     String
  created_at DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId], name: "review_user_unique")
  @@index([userId])
}

// ------------------------------------------------------------------------------------

model Payments {
  id             Int       @id @default(autoincrement())
  user_id        String
  mp_payment_id  String?
  description    String?
  price          Decimal?  @db.Decimal(10, 2)
  payer_email    String
  status         String?
  qr_code        String?
  qr_code_base64 String?
  qr_valid       DateTime?
  finished       Boolean   @default(false)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
}
