generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  username          String   @unique
  email             String   @unique
  name              String
  password          String
  profile_image_url String?
  bio               String?
  premium           Boolean  @default(false)
  role              Role     @default(USER)
  created_at        DateTime @default(now())

  userGames UserGame[]
  reviews   Review[]
  likes     ReviewLike[]
}

enum Role {
  USER
  ADMIN
}

// -------------------------------------------------

model UserGame {
  id     String     @id @default(cuid())
  userId String
  rawgId Int
  status GameStatus
  note   String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rawgId])
  @@index([userId, status])
  @@index([userId])
  @@index([rawgId])
}

enum GameStatus {
  BACKLOG
  PLAYING
  FINISHED
  DROPPED
}

// ------------------------------------------------------------------------------------

model Review {
  id           String       @id @default(cuid())
  userId       String
  rawgId       Int
  title        String
  body         String
  rating       Int
  isPublic     Boolean      @default(true)
  status       ReviewStatus @default(PUBLISHED)
  published_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  author User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes  ReviewLike[]

  @@unique([userId, rawgId], name: "userId_rawgId")
  @@index([isPublic, status, published_at])
  @@index([rawgId, isPublic, status, published_at])
  @@index([userId, status, updated_at])
}

model ReviewLike {
  id         String   @id @default(cuid())
  reviewId   String
  userId     String
  created_at DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId], name: "review_user_unique")
  @@index([userId])
}

enum ReviewStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
